# Notion internal integration token (from https://www.notion.so/my-integrations)
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your accounts database ID (from the URL: notion.so/<DATABASE_ID>?v=...)
NOTION_DATABASE_ID=3731b9a3054c808b9e66dfc877ddf5ce

# Optional: ID of a Notion page where route schedules will be created as sub-pages
# If blank, schedules are created at the top level of the integration's workspace
NOTION_SCHEDULES_PARENT_PAGE_ID=
